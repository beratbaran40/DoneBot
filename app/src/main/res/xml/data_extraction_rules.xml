<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Encrypted prefs are sealed by an Android Keystore master key that cannot leave the device,
             so restoring this file onto another device/install fails to decrypt (AEADBadTagException). -->
        <exclude domain="sharedpref" path="todo_prefs.xml" />
        <!-- Auth tokens live in the "user_prefs" Preferences DataStore; keep JWTs out of cloud backups. -->
        <exclude domain="file" path="datastore/" />
        <!-- Room DB is re-synced from the backend on login; don't carry it across installs. -->
        <exclude domain="database" path="todo_db" />
        <exclude domain="database" path="todo_db-shm" />
        <exclude domain="database" path="todo_db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="todo_prefs.xml" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="database" path="todo_db" />
        <exclude domain="database" path="todo_db-shm" />
        <exclude domain="database" path="todo_db-wal" />
    </device-transfer>
</data-extraction-rules>