<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reminders are a core function → USE_EXACT_ALARM is auto-granted on API 33+ (no Play
         exact-alarm declaration, no user revocation). SCHEDULE_EXACT_ALARM covers API 31-32 only. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Location intentionally NOT requested: the place picker (Google Places Autocomplete) works
         with text search alone, so no ACCESS_*_LOCATION is needed — keeps Play Data Safety simple.
         The Places SDK (places:3.5.0) still declares both location permissions itself, which merge
         in transitively; strip them so the SHIPPED manifest stays off Play's "Location" category. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <!-- In-the-moment Polaroid capture for Journal entries. Camera is optional so the
         install is not blocked on camera-less devices. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- DoneBot shows no ads and never reads the advertising ID. firebase-analytics merges these
         advertising/measurement permissions in transitively; strip all three so the SHIPPED (merged)
         manifest matches our Play Data Safety declaration of "no advertising-ID collection" and keeps
         the permission profile fully ads-free. See prod-readiness §6.17. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <application
        android:name=".Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_app_logo"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_app_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToDoApp"
        tools:replace="android:icon,android:roundIcon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ToDoApp.Splash"
            android:launchMode="singleTop"
            android:configChanges="locale|layoutDirection|uiMode|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="todoapp" android:host="reset-password" />
            </intent-filter>

            <!-- Verified https App Link for password reset. assetlinks.json is hosted at
                 https://donebot-backend.onrender.com/.well-known/assetlinks.json so Android opens the
                 app directly (no browser/custom-scheme hijack) once verification succeeds. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="donebot-backend.onrender.com"
                    android:path="/reset-password" />
            </intent-filter>
        </activity>

        <!-- Stores per-app locale set via AppCompatDelegate on API < 33 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name=".ui.overlay.OverlayService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm_overlay" />
        </service>
        <service
            android:name=".data.notification.NotificationService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm_overlay" />
        </service>
        <receiver
            android:name=".data.alarm.AlarmFireReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.alarm.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".data.source.remote.fcm.TDFireBaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".data.notification.PomodoroForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user_initiated_focus_timer" />
        </service>

        <receiver
            android:name=".data.notification.PomodoroSessionEndReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Firebase Analytics is bundled (pulled in alongside Crashlytics) but DoneBot logs no
             analytics events and uses no analytics-driven features (no Remote Config, A/B testing,
             audience-targeted FCM, or AdMob). Disable collection so no usage data is gathered and
             the Play Data Safety form needs no "App activity → App interactions" declaration.
             Crashlytics is unaffected and keeps reporting crashes, breadcrumbs, and custom keys. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <!-- Google Maps Platform API key. Sourced from local.properties (MAPS_API_KEY=…)
             via the manifestPlaceholder declared in app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
    </application>

</manifest>